# ─── Server ───────────────────────────────────────────────────────────────────
# PORT dipakai Coolify/Railway secara otomatis. APP_PORT sebagai fallback.
PORT=8080
APP_PORT=8080

# Set "release" di production (mematikan debug log Gin)
GIN_MODE=release

# URL publik API ini — dipakai untuk callback Xendit & link recovery password
APP_URL=https://api.example.com

# CORS + CSRF origin allowlist: pisahkan dengan koma (tanpa spasi).
# WAJIB memuat SEMUA origin frontend — origin yang tidak terdaftar akan
# kena 403 pada POST/PUT/PATCH/DELETE (CSRF check di auth middleware).
#   - Customer web  : https://quantumgamingcenter.com
#   - Admin web     : domain admin production
#   - Dev lokal     : http://localhost:5173 (atau kosongkan semua = dev mode)
# Kosongkan untuk mengizinkan semua origin (HANYA untuk local dev).
ALLOWED_ORIGINS=https://quantumgamingcenter.com,https://admin.quantumgamingcenter.com

# Reverse proxy yang dipercaya (CIDR/IP, pisahkan koma).
# WAJIB diisi jika di belakang Coolify/nginx agar rate limiting per-IP akurat.
# Kosongkan jika server diakses langsung.
TRUSTED_PROXIES=

# Set "true" jika API sudah full HTTPS (menambahkan header HSTS)
ENABLE_HSTS=true

# Flag Secure pada auth cookie (httpOnly). Default true.
# Set "false" HANYA untuk local dev via http://localhost.
COOKIE_SECURE=true

# ─── Database ─────────────────────────────────────────────────────────────────
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=game_lounge_db

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRED_HOURS=24

# ─── SMTP ─────────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_PASSWORD=
SMTP_SENDER_NAME=Game Lounge

# ─── Xendit (kosongkan untuk mock mode — invoice digenerate lokal) ────────────
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# ─── Moka POS ─────────────────────────────────────────────────────────────────
MOKA_BASE_URL=https://api.mokapos.com
MOKA_ACCESS_TOKEN=
MOKA_OUTLET_ID=
